# Copy to .env next to docker-compose.yml, or run `bash scripts/generate-secrets.sh` to create it
# with random secrets filled in. Docker Compose reads .env automatically.

# Required. 64 hex characters (32 bytes) that encrypt every user's 2FA secret.
# Never commit the real value and never change it later (users would have to set up 2FA again).
TOTP_ENCRYPTION_KEY=

# First start only: creates the first admin when no users exist yet. Remove after signing in.
# Required in production. Outside production (npm run dev:server) an empty value falls back to the
# default test admin admin@example.com / Admin@12345.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Development only (ignored when NODE_ENV=production): test accounts for the other roles, created
# once if missing. Set SEED_TEST_USERS=false to skip them and the default admin.
#TEST_MANAGER_EMAIL=manager@example.com
#TEST_MANAGER_PASSWORD=Manager@12345
#TEST_USER_EMAIL=user@example.com
#TEST_USER_PASSWORD=User@12345
#SEED_TEST_USERS=true

# Optional: turns on the Discover tab (paper search). Get a key at https://www.perplexity.ai/account/api
# Each search is one paid Perplexity Search API request; bibliographic details come from Crossref (free).
PERPLEXITY_API_KEY=
# Comma-separated sites to search (up to 20), or "none" for the whole web. Empty = built-in scholarly list.
#PERPLEXITY_DOMAIN_FILTER=

# Two-factor sign-in is required for every account. Set to false ONLY for a single-user install on
# your own machine: sign-in then needs just email + password. Setting it back to true makes every
# account without 2FA set it up at the next sign-in.
#REQUIRE_2FA=true

# Name shown in the authenticator app next to the 6-digit code.
TWOFA_ISSUER=Literature Review Tracker

# Behind an HTTPS reverse proxy set both: COOKIE_SECURE=true and TRUST_PROXY=1
COOKIE_SECURE=false
TRUST_PROXY=false
